rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /questions/{questionId} {
      allow read: if true;
      allow write: if false;
    }

    match /interest_submissions/{id} {
      allow create: if request.resource.data.keys().hasOnly(['fullName', 'phone', 'submittedAt'])
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && request.resource.data.fullName.size() <= 120
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 10
        && request.resource.data.phone.size() <= 40
        && request.resource.data.submittedAt is timestamp;
      allow read, update, delete: if false;
    }

    // Public splash counter (no PII). Updated in the same batch as a new interest_submissions doc.
    match /stats/{docId} {
      allow read: if true;
      allow create: if docId == 'splash'
        && request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count is int
        && request.resource.data.count == 1;
      allow update: if docId == 'splash'
        && request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count is int
        && request.resource.data.count == resource.data.count + 1;
      allow delete: if false;
    }

    match /challenges/{challengeId} {
      allow create: if request.resource.data.status == 'open'
        && request.resource.data.questionId is string
        && request.resource.data.questionPrompt is string
        && request.resource.data.questionPrompt.size() <= 4000
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 4000
        && (!('contactEmail' in request.resource.data)
            || (request.resource.data.contactEmail is string
                && request.resource.data.contactEmail.size() <= 200))
        && (!('claimedCorrectIndex' in request.resource.data)
            || (request.resource.data.claimedCorrectIndex is int
                && request.resource.data.claimedCorrectIndex >= 0
                && request.resource.data.claimedCorrectIndex <= 3));
      allow read, update, delete: if false;
    }

    function validDifficultyKey() {
      return request.resource.data.difficulty == 'easy'
        || request.resource.data.difficulty == 'somewhat_easy'
        || request.resource.data.difficulty == 'medium'
        || request.resource.data.difficulty == 'hard'
        || request.resource.data.difficulty == 'very_hard';
    }

    function triviaSubmissionWrongAnswersManual() {
      return request.resource.data.wrongAnswers is list
        && request.resource.data.wrongAnswers.size() == 3
        && request.resource.data.wrongAnswers[0] is string
        && request.resource.data.wrongAnswers[0].size() >= 1
        && request.resource.data.wrongAnswers[0].size() <= 500
        && request.resource.data.wrongAnswers[1] is string
        && request.resource.data.wrongAnswers[1].size() >= 1
        && request.resource.data.wrongAnswers[1].size() <= 500
        && request.resource.data.wrongAnswers[2] is string
        && request.resource.data.wrongAnswers[2].size() >= 1
        && request.resource.data.wrongAnswers[2].size() <= 500;
    }

    function triviaSubmissionBaseFields() {
      return request.resource.data.authorName is string
        && request.resource.data.authorName.size() >= 1
        && request.resource.data.authorName.size() <= 120
        && request.resource.data.prompt is string
        && request.resource.data.prompt.size() >= 1
        && request.resource.data.prompt.size() <= 2000
        && request.resource.data.correctAnswer is string
        && request.resource.data.correctAnswer.size() >= 1
        && request.resource.data.correctAnswer.size() <= 500
        && validDifficultyKey()
        && (request.resource.data.wrongAnswersSource == 'manual'
            || request.resource.data.wrongAnswersSource == 'ai_requested')
        && request.resource.data.status == 'pending'
        && request.resource.data.submittedAt is timestamp;
    }

    // User-submitted trivia ideas; admin reviews in Console (no public read).
    match /trivia_question_submissions/{id} {
      allow create: if triviaSubmissionBaseFields()
        && request.resource.data.keys().hasOnly([
          'authorName', 'prompt', 'correctAnswer', 'difficulty',
          'wrongAnswersSource', 'wrongAnswers', 'status', 'submittedAt'
        ])
        && (
          (request.resource.data.wrongAnswersSource == 'manual'
            && triviaSubmissionWrongAnswersManual())
          || (request.resource.data.wrongAnswersSource == 'ai_requested'
            && request.resource.data.wrongAnswers is list
            && request.resource.data.wrongAnswers.size() == 0)
        );

      allow create: if triviaSubmissionBaseFields()
        && request.auth != null
        && request.auth.uid == request.resource.data.submitterUid
        && request.resource.data.keys().hasOnly([
          'authorName', 'prompt', 'correctAnswer', 'difficulty',
          'wrongAnswersSource', 'wrongAnswers', 'status', 'submittedAt',
          'submitterUid', 'submitterDisplayName'
        ])
        && request.resource.data.submitterUid is string
        && request.resource.data.submitterDisplayName is string
        && request.resource.data.submitterDisplayName.size() <= 120
        && (
          (request.resource.data.wrongAnswersSource == 'manual'
            && triviaSubmissionWrongAnswersManual())
          || (request.resource.data.wrongAnswersSource == 'ai_requested'
            && request.resource.data.wrongAnswers is list
            && request.resource.data.wrongAnswers.size() == 0)
        );

      allow read, update, delete: if false;
    }

    function triviaSessionBase() {
      return request.resource.data.gameType == 'giants_trivia'
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 5
        && request.resource.data.totalQuestions == 5
        && request.resource.data.perfect is bool
        && request.resource.data.playedAt is timestamp
        && request.resource.data.answers is list
        && request.resource.data.answers.size() == 5;
    }

    // Trivia analytics event log: one document per completed 5-question round.
    match /trivia_game_sessions/{id} {
      allow create: if triviaSessionBase()
        && request.resource.data.keys().hasOnly([
          'score', 'totalQuestions', 'perfect', 'playedAt', 'gameType', 'answers'
        ]);

      allow create: if triviaSessionBase()
        && request.auth != null
        && request.auth.uid == request.resource.data.playerId
        && request.resource.data.keys().hasOnly([
          'score', 'totalQuestions', 'perfect', 'playedAt', 'gameType', 'answers',
          'playerId', 'playerDisplayName'
        ])
        && request.resource.data.playerId is string
        && request.resource.data.playerDisplayName is string
        && request.resource.data.playerDisplayName.size() <= 120;

      allow read: if true;
      allow update, delete: if false;
    }

    // Per signed-in player: lifetime totals for trivia leaderboard (client transaction).
    match /trivia_player_stats/{userId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'displayName', 'totalGames', 'totalCorrect', 'totalQuestionsAnswered',
          'perfectGames', 'accuracy', 'lastPlayedAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 120
        && request.resource.data.totalGames == 1
        && request.resource.data.totalQuestionsAnswered == 5
        && request.resource.data.totalCorrect is int
        && request.resource.data.totalCorrect >= 0
        && request.resource.data.totalCorrect <= 5
        && request.resource.data.perfectGames is int
        && request.resource.data.perfectGames == (request.resource.data.totalCorrect == 5 ? 1 : 0)
        && (request.resource.data.accuracy is float || request.resource.data.accuracy is int)
        && request.resource.data.accuracy >= 0
        && request.resource.data.accuracy <= 1
        && request.resource.data.lastPlayedAt is timestamp;

      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'displayName', 'totalGames', 'totalCorrect', 'totalQuestionsAnswered',
          'perfectGames', 'accuracy', 'lastPlayedAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 120
        && request.resource.data.totalGames is int
        && request.resource.data.totalCorrect is int
        && request.resource.data.totalQuestionsAnswered is int
        && request.resource.data.perfectGames is int
        && (request.resource.data.accuracy is float || request.resource.data.accuracy is int)
        && request.resource.data.accuracy >= 0
        && request.resource.data.accuracy <= 1
        && request.resource.data.lastPlayedAt is timestamp
        && request.resource.data.totalGames == resource.data.totalGames + 1
        && request.resource.data.totalQuestionsAnswered == resource.data.totalQuestionsAnswered + 5
        && request.resource.data.totalCorrect - resource.data.totalCorrect >= 0
        && request.resource.data.totalCorrect - resource.data.totalCorrect <= 5
        && request.resource.data.perfectGames == resource.data.perfectGames + ((request.resource.data.totalCorrect - resource.data.totalCorrect) == 5 ? 1 : 0);

      allow delete: if false;
    }

    // Rolling per-question counters for right/wrong answers + challenge volume.
    match /trivia_question_stats/{questionId} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasOnly([
          'questionId', 'questionPrompt', 'difficulty', 'category',
          'timesSeen', 'rightCount', 'wrongCount', 'challengeCount', 'lastUpdatedAt'
        ])
        && request.resource.data.questionId == questionId
        && request.resource.data.questionPrompt is string
        && request.resource.data.difficulty is string
        && request.resource.data.category is string
        && request.resource.data.timesSeen is int
        && request.resource.data.rightCount is int
        && request.resource.data.wrongCount is int
        && request.resource.data.challengeCount is int
        && (
          // First sighting from gameplay.
          (
            request.resource.data.timesSeen == 1
            && request.resource.data.rightCount + request.resource.data.wrongCount == 1
            && request.resource.data.challengeCount == 0
          )
          // First touch from a challenge before gameplay.
          || (
            request.resource.data.timesSeen == 0
            && request.resource.data.rightCount == 0
            && request.resource.data.wrongCount == 0
            && request.resource.data.challengeCount == 1
          )
        )
        && request.resource.data.lastUpdatedAt is timestamp;

      allow update: if request.resource.data.keys().hasOnly([
          'questionId', 'questionPrompt', 'difficulty', 'category',
          'timesSeen', 'rightCount', 'wrongCount', 'challengeCount', 'lastUpdatedAt'
        ])
        && request.resource.data.questionId == resource.data.questionId
        && request.resource.data.questionPrompt is string
        && request.resource.data.difficulty is string
        && request.resource.data.category is string
        && request.resource.data.timesSeen is int
        && request.resource.data.rightCount is int
        && request.resource.data.wrongCount is int
        && request.resource.data.challengeCount is int
        && (
          // Gameplay update: seen +1 and exactly one of right/wrong increments by 1.
          (
            request.resource.data.timesSeen == resource.data.timesSeen + 1
            && request.resource.data.challengeCount == resource.data.challengeCount
            && request.resource.data.rightCount + request.resource.data.wrongCount
              == request.resource.data.timesSeen
            && (
              (request.resource.data.rightCount == resource.data.rightCount + 1
                && request.resource.data.wrongCount == resource.data.wrongCount)
              || (request.resource.data.rightCount == resource.data.rightCount
                && request.resource.data.wrongCount == resource.data.wrongCount + 1)
            )
          )
          // Challenge update: only challengeCount increments.
          || (
            request.resource.data.timesSeen == resource.data.timesSeen
            && request.resource.data.rightCount == resource.data.rightCount
            && request.resource.data.wrongCount == resource.data.wrongCount
            && request.resource.data.challengeCount == resource.data.challengeCount + 1
          )
        )
        && request.resource.data.lastUpdatedAt is timestamp;

      allow delete: if false;
    }

    // Pinball mini-game: one document per score submission (public read, create-only).
    match /pinball_leaderboard/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['initials', 'score', 'at'])
        && request.resource.data.initials is string
        && request.resource.data.initials.size() == 3
        && request.resource.data.initials.matches('^[A-Z?]{3}$')
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 9999999
        && request.resource.data.at is timestamp;
      allow update, delete: if false;
    }
  }
}
